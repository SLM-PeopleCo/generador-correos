<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Generador de Mockups de Gmail</title>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: 'Google Sans', Roboto, Arial, sans-serif;
    background: #f0f4f9;
    color: #202124;
    font-size: 15px;
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .app-container { display: flex; flex: 1; height: 100vh; overflow: hidden; }

  .control-panel {
    width: 420px; background: #ffffff; border-right: 1px solid #dadce0;
    padding: 24px; display: flex; flex-direction: column; gap: 20px;
    overflow-y: auto; box-shadow: 4px 0 15px rgba(0,0,0,0.05); z-index: 10;
  }

  .control-panel h2 { margin: 0 0 5px 0; font-size: 22px; color: #1a73e8; font-weight: 500; }
  .control-panel p.subtitle { margin: 0 0 10px 0; font-size: 13.5px; color: #5f6368; }

  .form-group { display: flex; flex-direction: column; gap: 6px; }
  .form-group label { font-size: 13px; font-weight: 600; color: #3c4043; }
  .form-group input, .rich-textarea {
    padding: 12px 14px; border: 1px solid #dadce0; border-radius: 8px;
    font-size: 14px; font-family: inherit; transition: all 0.2s; background: #f8f9fa;
  }
  .form-group input:focus, .rich-textarea:focus {
    outline: none; border-color: #1a73e8; background: #fff; box-shadow: 0 0 0 2px rgba(26,115,232,0.2);
  }

  /* FORMATOS ENRIQUECIDOS Y CORRECCIÓN DE SALTOS DE LÍNEA */
  .rich-textarea {
    min-height: 250px; overflow-y: auto; outline: none;
  }
  
  .rich-textarea, .body-text {
    white-space: normal; /* Evita que se corten las frases a la mitad */
    word-wrap: break-word;
    line-height: 1.6;
  }

  /* Forzar renderizado de Negritas, Cursivas y Listas */
  .rich-textarea b, .rich-textarea strong, .body-text b, .body-text strong { font-weight: bold !important; }
  .rich-textarea i, .rich-textarea em, .body-text i, .body-text em { font-style: italic !important; }
  
  .rich-textarea ul, .body-text ul {
    display: block !important; list-style-type: disc !important;
    margin: 12px 0 12px 24px !important; padding-left: 16px !important;
  }
  .rich-textarea ol, .body-text ol {
    display: block !important; list-style-type: decimal !important;
    margin: 12px 0 12px 24px !important; padding-left: 16px !important;
  }
  .rich-textarea li, .body-text li {
    display: list-item !important; margin-bottom: 6px !important;
  }
  .rich-textarea p, .body-text p { margin: 0 0 12px 0 !important; }

  .download-btn {
    background: #1a73e8; color: white; border: none; border-radius: 28px;
    padding: 14px 24px; font-size: 15px; font-weight: 500; cursor: pointer;
    display: flex; align-items: center; justify-content: center; gap: 10px;
    transition: background 0.2s, box-shadow 0.2s; margin-top: 10px;
    box-shadow: 0 1px 3px rgba(60,64,67,.3);
  }
  .download-btn:hover:not(:disabled) { background: #1557b0; box-shadow: 0 4px 8px rgba(60,64,67,.2); }
  .download-btn:disabled { background: #a8c7fa; cursor: not-allowed; box-shadow: none; }

  .preview-container {
    flex: 1; overflow-y: auto; background: #fbfcfe; display: flex;
    justify-content: center; align-items: flex-start; padding: 20px;
  }

  .gmail-mockup {
    width: 100%; max-width: 1100px; background: #fbfcfe; border-radius: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.08); overflow: hidden; border: 1px solid #e1e3e6;
  }

  .topbar { display: flex; align-items: center; height: 76px; padding: 0 24px; gap: 20px; background: #fbfcfe; border-bottom: 1px solid #e1e3e6; }
  .menu-icon { font-size: 20px; color: #5f6368; margin-right: 4px; }
  .logo { display: flex; align-items: center; gap: 10px; flex-shrink: 0; }
  .logo-text { font-size: 24px; color: #3c4043; font-weight: 500; letter-spacing: -0.5px; }
  .search-bar { flex: 1; max-width: 760px; display: flex; align-items: center; background: #e9eef6; border-radius: 28px; height: 52px; padding: 0 20px; color: #5f6368; gap: 14px; }
  .search-bar span.placeholder { flex: 1; }
  .topbar-right { margin-left: auto; display: flex; align-items: center; gap: 20px; color: #5f6368; flex-shrink: 0; }
  .status-pill { display: flex; align-items: center; gap: 8px; border: 1px solid #dadce0; border-radius: 20px; padding: 8px 14px; font-size: 14px; color: #3c4043; }
  .status-dot { width: 9px; height: 9px; border-radius: 50%; background: #1e8e3e; }
  .circle-icon { width: 38px; height: 38px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 16px; }
  .avatar-google { width: 34px; height: 34px; border-radius: 50%; background: #dbe1e8; color: #5f6368; display: flex; align-items: center; justify-content: center; font-size: 18px; }

  .layout { display: flex; }
  .sidebar { width: 270px; flex-shrink: 0; padding: 12px 8px 0 12px; }
  .compose-btn { display: flex; align-items: center; gap: 14px; background: #ffffff; color: #3c4043; border-radius: 22px; padding: 16px 26px; margin: 8px 0 20px 0; font-weight: 500; font-size: 15px; width: fit-content; box-shadow: 0 1px 3px rgba(60,64,67,.3), 0 4px 8px rgba(60,64,67,.15); }
  .nav-item { display: flex; align-items: center; gap: 20px; padding: 0 20px; height: 34px; border-radius: 0 18px 18px 0; color: #3c4043; font-size: 14.5px; cursor: pointer; }
  .nav-item.active { background: #d3e3fd; color: #001d35; font-weight: 700; }
  .nav-item .count { margin-left: auto; font-weight: 400; font-size: 13px; color: #5f6368; }
  .nav-item.active .count { color: #001d35; font-weight: 700; }
  .nav-icon { width: 20px; text-align: center; color: #5f6368; flex-shrink: 0; }
  .nav-item.active .nav-icon { color: #001d35; }
  .nav-section-label { display: flex; align-items: center; gap: 12px; padding: 10px 20px; color: #3c4043; font-size: 14.5px; cursor: pointer; }

  .main { flex: 1; min-width: 0; background: #ffffff; border-top-left-radius: 16px; border-left: 1px solid #e1e3e6; }
  .toolbar { display: flex; align-items: center; gap: 24px; padding: 12px 28px; color: #5f6368; }
  .toolbar-icons { display: flex; align-items: center; gap: 26px; font-size: 16px; }
  .pager { margin-left: auto; display: flex; align-items: center; gap: 16px; font-size: 13.5px; color: #5f6368; }

  .msg-wrap { padding: 4px 32px 8px 32px; }
  .subject-row { display: flex; align-items: center; gap: 14px; padding: 10px 0 26px 0; }
  .subject-line { font-size: 24px; font-weight: 700; color: #202124; }
  .chip { display: flex; align-items: center; gap: 6px; background: #eef1f5; color: #3c4043; font-size: 13px; border-radius: 14px; padding: 5px 12px; }
  .subject-row-icons { margin-left: auto; display: flex; gap: 20px; color: #5f6368; font-size: 16px; }

  .msg-header { display: flex; align-items: flex-start; gap: 16px; padding: 4px 0 24px 0; }
  .avatar { width: 44px; height: 44px; border-radius: 50%; background: linear-gradient(135deg,#94a3b8,#334155); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 17px; font-weight: 600; flex-shrink: 0; }
  .msg-header-main { flex: 1; min-width: 0; }
  .sender-row { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
  .sender-name { font-size: 15.5px; font-weight: 700; color: #202124; }
  .sender-email { font-size: 14px; color: #5f6368; }
  .to-line { font-size: 13px; color: #5f6368; margin-top: 4px; cursor: default; display: flex; align-items: center; gap: 6px; }
  .msg-header-right { display: flex; align-items: center; gap: 18px; color: #5f6368; font-size: 13.5px; flex-shrink: 0; margin-left: 12px; }

  .body-text { color: #202124; padding-bottom: 34px; max-width: 900px; }
  .action-row { display: flex; align-items: center; gap: 14px; padding: 4px 0 32px 0; }
  .action-btn { display: flex; align-items: center; gap: 10px; border: 1px solid #dadce0; border-radius: 22px; padding: 12px 22px; font-size: 14.5px; color: #3c4043; font-weight: 500; }
  .icon-circle-btn { width: 46px; height: 46px; border: 1px solid #dadce0; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #5f6368; font-size: 17px; }

  @media (max-width: 900px) {
    .app-container { flex-direction: column; height: auto; overflow: auto; }
    .control-panel { width: 100%; height: auto; }
    .preview-container { height: auto; }
  }
</style>
</head>
<body>

  <div class="app-container">
    <div class="control-panel">
      <h2>Generador Gmail</h2>
      <p class="subtitle">Personaliza los campos y descarga tu mockup en tiempo real.</p>

      <div class="form-group">
        <label>Nombre del Remitente</label>
        <input type="text" id="input-name" value="Israel López">
      </div>
      <div class="form-group">
        <label>Correo del Remitente</label>
        <input type="text" id="input-email" value="israel.lopez@fiscalesotman.com.mx">
      </div>
      <div class="form-group">
        <label>Nombre del Destinatario</label>
        <input type="text" id="input-recipient" value="Myrna Aguilar">
      </div>
      <div class="form-group">
        <label>Asunto del Correo</label>
        <input type="text" id="input-subject" value="COTIZACION // CONSULTORÍA EN EL DESARROLLO DE OBJETIVOS EMPRESARIALES">
      </div>
      <div class="form-group">
        <label>Cuerpo del Mensaje (Pega tu texto aquí)</label>
        <div id="input-body" class="rich-textarea" contenteditable="true">Pega aquí tu contenido con viñetas y negritas.</div>
      </div>
      <div class="form-group">
        <label>Hora / Fecha</label>
        <input type="datetime-local" id="input-time" value="2023-09-08T09:51">
      </div>

      <button class="download-btn" id="download-btn">📷 Generar y Descargar Screenshot</button>
    </div>

    <div class="preview-container">
      <div class="gmail-mockup" id="gmail-mockup">
        <div class="topbar">
          <span class="menu-icon">☰</span>
          <div class="logo">
            <svg width="42" height="32" viewBox="0 0 48 36" xmlns="http://www.w3.org/2000/svg">
              <rect x="1" y="1" width="46" height="34" rx="5" fill="#ffffff"/>
              <path d="M7 27 L7 10" stroke="#4285F4" stroke-width="7" stroke-linecap="round" fill="none"/>
              <path d="M7 10 L24 22" stroke="#EA4335" stroke-width="7" stroke-linecap="round" fill="none"/>
              <path d="M24 22 L41 10" stroke="#FBBC05" stroke-width="7" stroke-linecap="round" fill="none"/>
              <path d="M41 10 L41 27" stroke="#34A853" stroke-width="7" stroke-linecap="round" fill="none"/>
            </svg>
            <span class="logo-text">Gmail</span>
          </div>
          <div class="search-bar"><span class="placeholder">Buscar en el correo electrónico</span></div>
          <div class="topbar-right"><div class="avatar-google">👤</div></div>
        </div>

        <div class="layout">
          <div class="sidebar">
            <div class="compose-btn">✏️ Redactar</div>
            <div class="nav-item active"><span class="nav-icon">📥</span> Recibidos</div>
          </div>

          <div class="main">
            <div class="msg-wrap">
              <div class="subject-row">
                <span class="subject-line" id="preview-subject">COTIZACION // CONSULTORÍA EN EL DESARROLLO DE OBJETIVOS EMPRESARIALES</span>
              </div>
              <div class="msg-header">
                <div class="avatar" id="preview-initials">IL</div>
                <div class="msg-header-main">
                  <div class="sender-row">
                    <span class="sender-name" id="preview-name">Israel López</span>
                    <span class="sender-email" id="preview-email">&lt;israel.lopez@fiscalesotman.com.mx&gt;</span>
                  </div>
                  <div class="to-line">para <span id="preview-recipient">Myrna Aguilar</span> ▾</div>
                </div>
                <div class="msg-header-right"><span id="preview-time">vie, 8 sep 2023, 9:51 a. m.</span></div>
              </div>

              <!-- El contenido renderizado se muestra aquí -->
              <div class="body-text" id="preview-body"></div>

              <div class="action-row">
                <div class="action-btn">↩ Responder</div>
                <div class="action-btn">➤ Reenviar</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    const inputName = document.getElementById('input-name');
    const inputEmail = document.getElementById('input-email');
    const inputRecipient = document.getElementById('input-recipient');
    const inputSubject = document.getElementById('input-subject');
    const inputBody = document.getElementById('input-body');
    const inputTime = document.getElementById('input-time');

    const previewName = document.getElementById('preview-name');
    const previewEmail = document.getElementById('preview-email');
    const previewRecipient = document.getElementById('preview-recipient');
    const previewSubject = document.getElementById('preview-subject');
    const previewBody = document.getElementById('preview-body');
    const previewTime = document.getElementById('preview-time');
    const previewInitials = document.getElementById('preview-initials');
    const downloadBtn = document.getElementById('download-btn');
    const gmailMockup = document.getElementById('gmail-mockup');

    function getInitials(name) {
      if (!name) return 'GM';
      const parts = name.trim().split(' ');
      if (parts.length >= 2) return (parts[0][0] + parts[1][0]).toUpperCase();
      return name.substring(0, 2).toUpperCase();
    }

    inputName.addEventListener('input', (e) => {
      previewName.textContent = e.target.value;
      previewInitials.textContent = getInitials(e.target.value);
    });
    inputEmail.addEventListener('input', (e) => previewEmail.textContent = `<${e.target.value}>`);
    inputRecipient.addEventListener('input', (e) => previewRecipient.textContent = e.target.value);
    inputSubject.addEventListener('input', (e) => previewSubject.textContent = e.target.value);

    // Mapeo en tiempo real del HTML
    inputBody.addEventListener('input', (e) => {
      previewBody.innerHTML = e.target.innerHTML;
    });

    // Filtro de pegado para unificar saltos de línea sin destruir listas ni negritas
    inputBody.addEventListener('paste', (e) => {
      e.preventDefault();
      const clipboardData = e.clipboardData || window.clipboardData;
      let htmlData = clipboardData.getData('text/html');
      
      if (htmlData) {
        document.execCommand('insertHTML', false, htmlData);
      } else {
        // Si pegan texto plano, lo convertimos a párrafos
        let textData = clipboardData.getData('text/plain');
        let formattedText = textData.split('\n').map(line => `<p>${line}</p>`).join('');
        document.execCommand('insertHTML', false, formattedText);
      }
    });

    function formatearFechaGmail(fecha) {
      const dias = ['dom', 'lun', 'mar', 'mié', 'jue', 'vie', 'sáb'];
      const meses = ['ene', 'feb', 'mar', 'abr', 'may', 'jun', 'jul', 'ago', 'sep', 'oct', 'nov', 'dic'];
      let horas = fecha.getHours();
      const minutos = String(fecha.getMinutes()).padStart(2, '0');
      const ampm = horas >= 12 ? 'p. m.' : 'a. m.';
      horas = horas % 12 || 12; 
      return `${dias[fecha.getDay()]}, ${fecha.getDate()} ${meses[fecha.getMonth()]} ${fecha.getFullYear()}, ${horas}:${minutos} ${ampm}`;
    }

    inputTime.addEventListener('input', (e) => {
      const dateVal = new Date(e.target.value);
      if (!isNaN(dateVal.getTime())) previewTime.textContent = formatearFechaGmail(dateVal);
    });
    inputTime.dispatchEvent(new Event('input'));

    downloadBtn.addEventListener('click', () => {
      downloadBtn.textContent = "Generando imagen...";
      downloadBtn.disabled = true;

      html2canvas(gmailMockup, {
        scale: 2, width: 1090, windowWidth: 1090, useCORS: true, logging: false,
        onclone: function(clonedDoc) {
          clonedDoc.body.style.width = '1090px';
          const clonedMockup = clonedDoc.getElementById('gmail-mockup');
          clonedMockup.style.width = '1090px';
          clonedMockup.style.margin = '0';
          clonedMockup.style.border = 'none';
        }
      }).then(canvas => {
        const link = document.createElement('a');
        link.href = canvas.toDataURL('image/png');
        link.download = 'mockup-gmail.png'; 
        link.click();
        downloadBtn.textContent = "📷 Generar y Descargar Screenshot";
        downloadBtn.disabled = false;
      }).catch(() => {
        alert("Hubo un error al generar la captura.");
        downloadBtn.disabled = false;
      });
    });
  </script>
</body>
</html>
